# Local development can omit DATABASE_URL and uses ./students.db.
# Set DATABASE_URL to the Neon connection string in Vercel.
DATABASE_URL=
SECRET_KEY=

# Set both once to create the first administrator. Remove them after setup.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Local-only demo credentials; use unique strong passwords on Vercel.
DEMO_TEACHER_EMAIL=teacher@gmail.com
DEMO_TEACHER_PASSWORD=teach
DEMO_STUDENT_EMAIL=student@gmail.com
DEMO_STUDENT_PASSWORD=student
